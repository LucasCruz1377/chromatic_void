[resource]
script = ExtResource("1")
Id = &"fevereiro_carnaval"
Nome = "Frenesi Carnavalesco"
Descricao = "Aumenta velocidade, dano e cadência por alguns segundos, deixando rastros multicoloridos que ferem inimigos. No Monthly Colors, fevereiro apresenta o Carnaval como uma explosão de cor, ritmo e identidade cultural — por isso o poder vira um frenesi neon."
