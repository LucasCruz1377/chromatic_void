[resource]
script = ExtResource("1")
Id = &"abril_azul"
Nome = "Foco Absoluto"
Descricao = "Desacelera o mundo enquanto a nave mantém sua capacidade de manobra. No Monthly Colors, Abril Azul reforça conscientização sobre o autismo, inclusão e respeito às diferentes formas de perceber o mundo; o foco temporal funciona somente como metáfora visual do jogo."
Icone = ExtResource("2")
MonthlyColorsSelo = "ABRIL AZUL • INCLUSÃO"
MonthlyColorsContexto = "A relação está no respeito às diferentes percepções de mundo; a habilidade não associa capacidades especiais a pessoas autistas."
Cooldown = 12.0
escala_tempo = 0.35
duracao_real = 2.5
