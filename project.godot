locale/locale_filter_mode=1

[layer_names]

2d_render/layer_1="Colisores"
2d_render/layer_2="Player"
2d_render/layer_3="Inimigo"
2d_render/layer_4="Balas"
2d_physics/layer_1="Colisores"
2d_physics/layer_2="Player"
2d_physics/layer_3="Inimigos"
2d_physics/layer_4="Balas"

[physics]

