; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chromatic Void"
config/description="Jogo colorido inspirado em Asteroids(1979) - Atari"
config/version="0.5.0-dev"
run/main_scene="res://Rooms/TelaInicial.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="res://Icon_Splash/PolyIcon.png"

[autoload]

Global="*res://Scripts/Global.gd"
GerenciadorDeSave="*res://Scripts/GerenciadorDeSave.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
mouse_cursor/tooltip_position_offset=Vector2(0, 0)

[file_customization]

folder_colors={
"res://Rooms/": "orange",
"res://Scripts/": "yellow"
}

[global_group]

parede=""
player=""
spawners=""
camera=""
inimigo=""
projeteis=""

